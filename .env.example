PUBLIC_URL=https://poker.example.com
PORT=3000
# Вход через Google или Telegram (если задан хотя бы один — гостей нет). Client ID типа «Web application» из Google Cloud Console.
# В «Authorized JavaScript origins» добавьте адрес сайта с игрой (например https://poker.example.com).
# Без этой строки сервер работает в режиме разработки (вход по токену браузера).
GOOGLE_CLIENT_ID=
# Вход через Telegram: бот от @BotFather (токен и имя без @). Домен сайта задаётся у @BotFather командой /setdomain.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# секрет подписи сессий (если пусто — создаётся автоматически в data/secret.key)
SESSION_SECRET=
# для сайта на GitHub Pages: адрес сервера при сборке
# VITE_SERVER_URL=https://poker-api.example.com
